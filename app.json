{
  "expo": {
    "name": "Events",
    "slug": "LakeGenevaEventsRN",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lakegenevaeventsrn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "joe.LGTv2",
      "backgroundColor": "#808080",
      "config": {},
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "This app uses maps to display event locations. Your device location is not collected, stored, or tracked by us."
      }
    },
    "android": {
      "package": "com.josephscholtz.lakegenevaeventsrn",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "backgroundColor": "#808080",
      "barStyle": "dark-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#808080",
      "barStyle": "dark-content"
    },
    "web": {
      "output": "static",
      "favicon": ""
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "backgroundColor": "#808080",
          "ios": {
            "image": "./assets/splash.png",
            "imageWidth": 420,
            "resizeMode": "contain",
            "enableFullScreenImage_legacy": false,
            "backgroundColor": "#808080"
          },
          "dark": {
            "backgroundColor": "#808080"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b56a272-1da4-4e98-b59a-9642b6af2c99"
      }
    },
    "owner": "jscholtz"
  }
}
